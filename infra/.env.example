# ═══════════════════════════════════════════════════════════════════════════════
# M8M Environment Configuration
# Copy to .env and adjust values for your environment
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=m8m
POSTGRES_PASSWORD=m8m_secret
POSTGRES_DB=m8m
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://m8m:m8m_secret@postgres:5432/m8m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
PUBLISH_COOLDOWN_SECONDS=10
WORKER_MAX_CONCURRENT_ACTIVITIES=20

# ── Ollama LLM ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://172.17.0.1:11434
OLLAMA_MODEL=qwen3-vl
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# ── Secret Vault ──────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
# Never use this placeholder in production.
SECRET_VAULT_KEY=REPLACE_WITH_openssl_rand_hex_32

# ── LLM Cache ─────────────────────────────────────────────────────────────────
LLM_CACHE_TTL=3600

# ── Token Budget ──────────────────────────────────────────────────────────────
MAX_TOTAL_TOKENS=100000
MAX_COST_USD=5.00

# ── Storage ───────────────────────────────────────────────────────────────────
MODEL_STORAGE_PATH=/app/storage/models

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:4200

# ── Database Pool ─────────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── Ports ─────────────────────────────────────────────────────────────────────
FRONTEND_PORT=4200
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── External API Keys (optional — also settable via Secret Vault) ─────────────
# M8M_SECRET_OPENAI_API_KEY=sk-...
# M8M_SECRET_GEMINI_API_KEY=...
# M8M_SECRET_OPENROUTER_API_KEY=...

# ── Systems Service ───────────────────────────────────────────────────────────
SYSTEMS_URL=http://systems:8001
SYSTEMS_PORT=8001

# REQUIRED — generate with: openssl rand -hex 16
INTERNAL_SECRET=REPLACE_WITH_openssl_rand_hex_16
